/* ================================================================== *
 * Body assembly
 * ================================================================== */
const PAGE_W = 11906;
const MARGIN = 1418;
const CONTENT_W = PAGE_W - MARGIN * 2;

function para(pPr, runs) {
  return `<w:p>${pPr || ''}${runs || ''}</w:p>`;
}
function pStyle(id, extra) {
  return `<w:pPr><w:pStyle w:val="${id}"/>${extra || ''}</w:pPr>`;
}
const PAGE_BREAK_PARA = para('<w:pPr><w:spacing w:after="0"/></w:pPr>', '<w:r><w:br w:type="page"/></w:r>');

/** The Word TOC field paragraph (levels 1-3, hyperlinked, marked dirty). */
function tocFieldParagraphXml() {
  return (
    '<w:p><w:pPr><w:pStyle w:val="Normal"/><w:spacing w:after="60"/></w:pPr>' +
    '<w:r><w:fldChar w:fldCharType="begin" w:dirty="true"/></w:r>' +
    '<w:r><w:instrText xml:space="preserve">TOC \\o "1-3" \\h \\z \\u</w:instrText></w:r>' +
    '<w:r><w:fldChar w:fldCharType="separate"/></w:r>' +
    `<w:r><w:rPr><w:i/><w:color w:val="808080"/></w:rPr>${t(CANON_TOC_PLACEHOLDER)}</w:r>` +
    '<w:r><w:fldChar w:fldCharType="end"/></w:r></w:p>'
  );
}

/**
 * Synthesise the title page + TOC the corpus does not carry itself.
 *
 * When a volume is assembled from a corpus that has no "# " H1, there is no H1
 * for the emitter to promote to the title page, so the volume would ship without
 * a title page and without a TOC field. An output may therefore ask for one
 * explicitly ("titlePage": true in the split manifest).
 *
 * The injected blocks deliberately reuse the ordinary "toc" block type so the
 * title page and the TOC field are part of the canonical text as well - the
 * converter's own body digest therefore stays self-consistent and the measure
 * it publishes is not inflated by text the source could never produce.
 */
function withSyntheticTitlePage(blocks, opt) {
  if (!blocks.length) return blocks;
  const realTitle = blocks[0] && blocks[0].type === 'heading' && blocks[0].level === 1;
  const hasToc = blocks.some((b) => b.type === 'toc');
  if (realTitle && hasToc) return blocks;
  const out = [];
  if (!realTitle) {
    out.push({ type: 'heading', level: 1, text: stripInlineSyntax(opt.title || '') });
    if (opt.subtitle) out.push({ type: 'subtitle', text: String(opt.subtitle) });
    if (!hasToc) out.push({ type: 'toc' });
  }
  for (const b of blocks) out.push(b);
  return out;
}

/**
 * Emit OOXML for a block list, invoking ctx.emit(chunkXml) for each fragment.
 * The visible text of each fragment is measured separately, by scanning the XML
 * on its way into the ZIP stream (see TextMeasurer), so the digest can never
 * drift from what was actually written.
 */
function emitBlocks(blocks, ctx) {
  const stats = ctx.stats;
  const emit = ctx.emit;
  let firstH1 = true;

  // Every fragment goes through this wrapper rather than ctx.emit directly, so
  // the ordered serialiser covers the whole emitter: pPr/rPr/tblPr children are
  // re-ordered into their canonical WordprocessingML sequence on the way out,
  // no matter which ad-hoc string in this function produced them. That is what
  // makes the fix structural instead of one-off.
  const emitBatch = (chunk) => {
    if (chunk) emit(normalizeOrderedElements(chunk));
  };

  for (const b of blocks) {
    switch (b.type) {
      case 'heading': {
        const lvl = Math.min(6, Math.max(1, b.level));
        if (lvl === 1 && firstH1 && !ctx.isContinuation) {
          firstH1 = false;
          emitBatch(para(pStyle('TitlePageTitle'), inlineToXml(b.text, ctx.relAlloc)));
          stats.paragraphs++;
          stats.headings[1]++;
          if (ctx.subtitle) {
            emitBatch(para(pStyle('TitlePageSubtitle'), inlineToXml(ctx.subtitle, ctx.relAlloc)));
            stats.paragraphs++;
          }
          emitBatch(PAGE_BREAK_PARA);
          stats.paragraphs++;
          continue;
        }
        if (lvl === 1) firstH1 = false;
        emitBatch(para(pStyle('Heading' + lvl), inlineToXml(b.text, ctx.relAlloc)));
        stats.paragraphs++;
        stats.headings[lvl]++;
        break;
      }
      case 'subtitle': {
        // Only produced by withSyntheticTitlePage() for a corpus with no H1:
        // the H1 path below the title-page branch already writes the subtitle.
        emitBatch(para(pStyle('TitlePageSubtitle'), inlineToXml(b.text, ctx.relAlloc)));
        stats.paragraphs++;
        break;
      }
      case 'para': {
        // A soft line break: the space before <w:br/> keeps the two lines from
        // being fused into one word (HTML collapses the equivalent newline to a
        // space), and it is what the markdown-side canonical join produces too.
        const runs = b.lines.map((l) => inlineToXml(l, ctx.relAlloc)).join(' <w:r><w:br/></w:r>');
        emitBatch(para('', runs));
        stats.paragraphs++;
        break;
      }
      case 'list': {
        for (const it of b.items) {
          let text = it.parts.join(' ');
          const task = /^\[( |x|X)\]\s+(.*)$/.exec(text);
          if (task) text = (task[1].toLowerCase() === 'x' ? '\u2611 ' : '\u2610 ') + task[2];
          const pPr = `<w:pPr><w:pStyle w:val="ListParagraph"/><w:numPr><w:ilvl w:val="${
            it.level
          }"/><w:numId w:val="${
            it.ordered ? 2 : 1
          }"/></w:numPr><w:spacing w:before="0" w:after="60" w:line="276" w:lineRule="auto"/><w:jc w:val="left"/></w:pPr>`;
          emitBatch(para(pPr, inlineToXml(text, ctx.relAlloc)));
          stats.paragraphs++;
          stats.listItems++;
        }
        break;
      }
      case 'table': {
        const cols = Math.max(1, b.header.length);
        const width = Math.floor(CONTENT_W / cols);
        const border =
          '<w:tblBorders><w:top w:val="single" w:sz="6" w:space="0" w:color="7F7F7F"/><w:left w:val="single" w:sz="6" w:space="0" w:color="7F7F7F"/><w:bottom w:val="single" w:sz="6" w:space="0" w:color="7F7F7F"/><w:right w:val="single" w:sz="6" w:space="0" w:color="7F7F7F"/><w:insideH w:val="single" w:sz="6" w:space="0" w:color="7F7F7F"/><w:insideV w:val="single" w:sz="6" w:space="0" w:color="7F7F7F"/></w:tblBorders>';
        emitBatch(
          `<w:tbl><w:tblPr><w:tblStyle w:val="TableGrid"/><w:tblW w:w="${CONTENT_W}" w:type="dxa"/><w:tblLayout w:type="fixed"/>` +
            border +
            `<w:tblCellMar><w:top w:w="60" w:type="dxa"/><w:left w:w="100" w:type="dxa"/><w:bottom w:w="60" w:type="dxa"/><w:right w:w="100" w:type="dxa"/></w:tblCellMar></w:tblPr><w:tblGrid>` +
            b.header.map(() => `<w:gridCol w:w="${width}"/>`).join('') +
            '</w:tblGrid>'
        );
        // header row: shaded + repeats across page breaks
        emitBatch(
          '<w:tr><w:trPr><w:tblHeader/><w:cantSplit/></w:trPr>' +
            b.header
              .map(
                (h, ci) =>
                  `<w:tc><w:tcPr><w:tcW w:w="${width}" w:type="dxa"/><w:shd w:val="clear" w:color="auto" w:fill="D9E2F3"/><w:vAlign w:val="center"/></w:tcPr>` +
                  para(
                    `<w:pPr><w:spacing w:before="40" w:after="40" w:line="240" w:lineRule="auto"/><w:jc w:val="${
                      b.align[ci] || 'left'
                    }"/></w:pPr>`,
                    inlineToXml(h, ctx.relAlloc).replace(
                      /<w:r>(?!<w:rPr>)/g,
                      '<w:r><w:rPr><w:b/></w:rPr>'
                    )
                  ) +
                  '</w:tc>'
              )
              .join('') +
            '</w:tr>'
        );
        for (const row of b.rows) {
          emitBatch(
            '<w:tr><w:trPr><w:cantSplit/></w:trPr>' +
              b.header
                .map((_, ci) => {
                  const cell = row[ci] === undefined ? '' : row[ci];
                  return (
                    `<w:tc><w:tcPr><w:tcW w:w="${width}" w:type="dxa"/><w:vAlign w:val="top"/></w:tcPr>` +
                    para(
                      `<w:pPr><w:spacing w:before="40" w:after="40" w:line="240" w:lineRule="auto"/><w:jc w:val="${
                        b.align[ci] || 'left'
                      }"/></w:pPr>`,
                      inlineToXml(cell, ctx.relAlloc)
                    ) +
                    '</w:tc>'
                  );
                })
                .join('') +
              '</w:tr>'
          );
        }
        emitBatch('</w:tbl>' + para('<w:pPr><w:spacing w:after="0" w:line="120" w:lineRule="auto"/></w:pPr>', ''));
        stats.tables++;
        stats.paragraphs++;
        break;
      }
      case 'code': {
        stats.codeBlocks++;
        stats.codeLines += b.lines.length;
        if (b.lang) {
          emitBatch(
            para(
              pStyle('SourceCode', '<w:spacing w:before="160" w:after="0"/>'),
              `<w:r><w:rPr><w:noProof/><w:rFonts w:ascii="Consolas" w:hAnsi="Consolas"/><w:b/><w:sz w:val="17"/><w:color w:val="7F7F7F"/></w:rPr>${t(
                b.lang
              )}</w:r>`
            )
          );
          stats.paragraphs++;
        }
        if (b.lines.length === 0) {
          emitBatch(para(pStyle('SourceCode', '<w:spacing w:before="160" w:after="160"/>'), '<w:r><w:rPr><w:noProof/></w:rPr><w:t> </w:t></w:r>'));
          stats.paragraphs++;
        }
        for (let k = 0; k < b.lines.length; k++) {
          const text = b.lines[k].replace(/\t/g, '    ');
          emitBatch(
            para(
              pStyle(
                'SourceCode',
                (k === 0 && !b.lang ? '<w:spacing w:before="160"/>' : '') +
                  (k === b.lines.length - 1 ? '<w:spacing w:after="160"/>' : '')
              ),
              `<w:r><w:rPr><w:noProof/><w:rFonts w:ascii="Consolas" w:hAnsi="Consolas"/><w:sz w:val="19"/><w:szCs w:val="19"/></w:rPr>${t(
                text
              )}</w:r>`
            )
          );
          stats.paragraphs++;
        }
        break;
      }
      case 'quote': {
        let group = [];
        const flushQuote = () => {
          if (!group.length) return;
          emitBatch(para(pStyle('BlockQuote'), inlineToXml(group.join(' '), ctx.relAlloc)));
          stats.paragraphs++;
          stats.quotes++;
          group = [];
        };
        for (const p of b.text.split('\n')) {
          if (/^\s*$/.test(p)) flushQuote();
          else group.push(p.trim());
        }
        flushQuote();
        break;
      }
      case 'hr': {
        // A horizontal rule is a paragraph border with no visible glyph, so it
        // carries a U+2015 sentinel run: Word renders it invisibly, and the text
        // scanner measures it, which keeps the markdown-side canonical text (which
        // also uses U+2015 for a rule) comparable character for character.
        emitBatch(para(pStyle('HorizontalRule'), `<w:r><w:rPr><w:sz w:val="2"/></w:rPr>${t(CANON_RULE)}</w:r>`));
        stats.paragraphs++;
        stats.rules++;
        break;
      }
      case 'figure': {
        stats.figures++;
        emitBatch(
          para(
            pStyle('FigurePlaceholder'),
            `<w:r><w:rPr><w:b/><w:color w:val="C00000"/><w:rFonts w:ascii="Consolas" w:hAnsi="Consolas"/></w:rPr>${t(
              CANON_FIGURE_PREFIX
            )}</w:r>` +
              `<w:r><w:rPr><w:color w:val="C00000"/><w:rFonts w:ascii="Consolas" w:hAnsi="Consolas"/></w:rPr>${t(
                b.text
              )}</w:r>`
          )
        );
        stats.paragraphs++;
        break;
      }
      case 'toc': {
        emitBatch(para(pStyle('TOCHeading'), `<w:r>${t('Table of Contents')}</w:r>`));
        stats.paragraphs++;
        emitBatch(
          '<w:p><w:pPr><w:pStyle w:val="Normal"/><w:spacing w:after="60"/></w:pPr>' +
            '<w:r><w:fldChar w:fldCharType="begin" w:dirty="true"/></w:r>' +
            '<w:r><w:instrText xml:space="preserve">TOC \\o "1-3" \\h \\z \\u</w:instrText></w:r>' +
            '<w:r><w:fldChar w:fldCharType="separate"/></w:r>' +
            `<w:r><w:rPr><w:i/><w:color w:val="808080"/></w:rPr>${t(CANON_TOC_PLACEHOLDER)}</w:r>` +
            '<w:r><w:fldChar w:fldCharType="end"/></w:r></w:p>'
        );
        stats.paragraphs++;
        emitBatch(PAGE_BREAK_PARA);
        stats.paragraphs++;
        break;
      }
      default:
        break;
    }
  }
  ctx.isContinuation = true;
}

/* ================================================================== *
 * XML text scanner: measures the visible text written to document.xml
 *
 * It walks the byte stream counting <w:t> content and paragraph boundaries. The
 * completeness digest is taken from THIS sweep, so the digest always describes
 * what was actually written to the package rather than what the writer intended.
 *
 * Chunk-boundary safety: the buffer is only consumed up to a safe point. While
 * inside a text node the buffer is held until the closing </w:t> is seen; the
 * rest is consumed per complete tag. Callers also batch their writes (see
 * FLUSH_BYTES in buildDocument) so a bare space run can never be stranded.
 * ================================================================== */
class XmlTextScanner {
  constructor() {
    this.buf = '';
    this.paragraphs = [];
    this.current = [];
    this.inTextKind = null; // 't' | 'w:instrText' | 'w:delText' | null
    this.total = 0;
  }

  push(chunk) {
    this.buf += chunk;
    this._scan(false);
  }

  _scan(final) {
    let i = 0;
    while (true) {
      if (this.inTextKind) {
        const closeTag = this.inTextKind === 't' ? '</w:t>' : '</' + this.inTextKind + '>';        const end = this.buf.indexOf(closeTag, i);
        if (end === -1) {
          if (final) {
            throw new Error('md2docx: unterminated <' + this.inTextKind + '> while measuring text');
          }
          break; // keep the partial text node for the next chunk
        }
        if (this.inTextKind === 't') {
          this.current.push(unesc(this.buf.slice(i, end)));
        }
        this.inTextKind = null;
        i = end + closeTag.length;
        continue;
      }
      const start = this.buf.indexOf('<', i);
      if (start === -1) {
        i = this.buf.length;
        break;
      }
      const gt = this.buf.indexOf('>', start);
      if (gt === -1) break; // partial tag at the tail: keep it for the next chunk
      if (start > i) {
        // Text that sits between two tags. This is real content: a run may be a
        // bare space (emitted before <w:br/> to separate two soft-wrapped lines),
        // so dropping it would fuse the words on either side. Word ignores such
        // whitespace, but the completeness measurement must not.
        this.current.push(unesc(this.buf.slice(i, start)));
      }
      const tag = this.buf.slice(start, gt + 1);
      if (/^<w:t(?:\s[^>]*)?>$/.test(tag)) {
        this.inTextKind = 't';
        i = gt + 1;
        continue;
      }
      if (/^<w:t(?:\s[^>]*)?\/>$/.test(tag)) {
        i = gt + 1; // self-closing <w:t/> contributes nothing, not even a separator
        continue;
      }
      // Field instructions and tracked-deletion text are not visible content:
      // <w:instrText> can hold "TOC \o \"1-3\" ..." or " PAGE ", which Word never
      // shows. They must be excluded or the completeness digest would report
      // phantom text that has no counterpart in the Markdown.
      if (/^<w:instrText(?:\s[^>]*)?>$/.test(tag)) {
        this.inTextKind = 'w:instrText';
        i = gt + 1;
        continue;
      }
      if (/^<w:delText(?:\s[^>]*)?>$/.test(tag)) {
        this.inTextKind = 'w:delText';
        i = gt + 1;
        continue;
      }
      if (tag === '</w:instrText>' || tag === '</w:delText>') {
        this.inTextKind = null;
        i = gt + 1;
        continue;
      }
      if (tag === '</w:p>' || /^<w:p\s/.test(tag)) {
        this._flushParagraph();
        i = gt + 1;
        continue;
      }
      i = gt + 1;
    }
    this.buf = this.buf.slice(i);
    if (final) {
      this._flushParagraph();
      this.buf = '';
    }
  }

  _flushParagraph() {
    // Concatenate the runs FIRST, then trim once. A whitespace-only run (the
    // space emitted before a <w:br/>) must not be trimmed away, or "... a soft"
    // and "line break ..." would be measured as the single word "softline".
    // canon() then collapses whitespace, and the markdown side reproduces that
    // exact collapse, so both digests are comparable.
    const text = this.current.join('').trim();
    this.total += text.length;
    if (text) {
      this.paragraphs.push(text);

    }
    this.current = [];
  }

  finish() {
    this._scan(true);
    return this.total;
  }
}
/* ================================================================== *
 * Argument / config handling
 * ================================================================== */
function parseArgs(argv) {
  const out = {
    inputs: [],
    config: null,
    output: null,
    title: null,
    author: 'FYP Proposal',
    subtitle: null,
    _positional: [],
  };
  for (let i = 0; i < argv.length; i++) {
    const a = argv[i];
    if (a === '--input' || a === '-i') {
      const v = argv[++i];
      if (!v) throw new Error('--input needs a value');
      out.inputs.push(...v.split(/[,;]/).filter(Boolean));
    } else if (a === '--output' || a === '-o') out.output = argv[++i];
    else if (a === '--title' || a === '-t') out.title = argv[++i];
    else if (a === '--author') out.author = argv[++i];
    else if (a === '--subtitle') out.subtitle = argv[++i];
    else if (a === '--config' || a === '-c') out.config = argv[++i];
    else if (a === '--selftest') out.selftest = true;
    else if (a === '--help' || a === '-h') out.help = true;
    else if (!a.startsWith('-')) out._positional.push(a);
  }

  /*
   * Positional convention:  <input.md> [more.md ...] <output.docx> [title]
   *
   * The output is the FIRST positional with a .docx extension (that is where the
   * user always puts it), and everything after it is treated as the title. Using
   * the LAST .docx-looking positional instead is wrong: a perfectly ordinary title
   * such as "Sample.docx Migration Report" would be mistaken for the output path.
   */
  if (!out.output) {
    const idx = out._positional.findIndex((p) => /\.docx$/i.test(p));
    if (idx >= 0) {
      out.output = out._positional[idx];
      out.inputs.push(...out._positional.slice(0, idx));
      const rest = out._positional.slice(idx + 1);
      if (rest.length && !out.title) out.title = rest.join(' ');
    } else {
      out.inputs.push(...out._positional);
    }
  } else {
    out.inputs.push(...out._positional);
  }
  delete out._positional;
  return out;
}

const USAGE = `md2docx convert.js - Markdown to .docx (no pandoc required)

  node convert.js <input.md> [more.md ...] <output.docx> [title]
  node convert.js --input a.md,b.md --output out.docx [--title "T"] [--subtitle "S"]
  node convert.js --config plan.json
  node convert.js --selftest

--config JSON shape:
  { "title": "...", "author": "...", "subtitle": "...",
    "inputs": ["01.md","02.md"],
    "outputs": [ { "path": "all.docx", "title": "Combined" },
                 { "path": "vol1.docx", "title": "Volume 1",
                   "rules": { "include": ["1-6","12-20"], "exclude": [], "match": null,
                              "frontMatter": true } } ] }

Relative paths inside a config are resolved against the config file's directory.
An output may also set "titlePage": true to synthesise a title page and a TOC
field when the corpus has no "# " H1 to promote (e.g. "## 7. Cisco Networking").

--selftest runs the built-in parser/emitter assertions (table pipe handling,
section keys, inline syntax) and exits non-zero on the first failure.`;

/* ================================================================== *
 * Built-in self-test
 *
 * table pipe handling is the part most likely to silently corrupt a document, so
 * the exact rules are asserted here rather than only described in comments:
 *   node convert.js --selftest
 * ================================================================== */
function runSelfTest() {
  const results = [];
  const check = (name, actual, expected) => {
    const a = JSON.stringify(actual);
    const e = JSON.stringify(expected);
    const ok = a === e;
    results.push({ name, ok, actual: a, expected: e });
    return ok;
  };
  const count = (row) => splitTableRow(row).length;

  // --- escaped pipes -------------------------------------------------------
  check('\\| becomes a literal pipe in ONE cell', splitTableRow('| a | b \\| c | d |'), [
    'a',
    'b | c',
    'd',
  ]);
  check('\\| cell count is 3', count('| a | b \\| c | d |'), 3);
  check('real-corpus escaped-pipe cell', splitTableRow('| `DL-{Share}-{RW\\|RO}` | Domain Local | Mapped |'), [
    '`DL-{Share}-{RW|RO}`',
    'Domain Local',
    'Mapped',
  ]);

  // --- pipes inside inline code spans -------------------------------------
  check('pipe inside a code span is content', splitTableRow('| `a|b` | plain | x |'), [
    '`a|b`',
    'plain',
    'x',
  ]);
  check('several code spans still resynchronise', splitTableRow('| `a|b` | `c|d` | e |'), [
    '`a|b`',
    '`c|d`',
    'e',
  ]);
  check('code span with braces', splitTableRow('| Member `{A|B|C|D}` | path | z |'), [
    'Member `{A|B|C|D}`',
    'path',
    'z',
  ]);
  check('awk example keeps its pipe', count("| 2 | x | `awk -F: '($2==\"\"){print $1}' /etc/shadow` | y |"), 4);
  // the exact row from sections/06-automation.md line 1129 of the real corpus
  check(
    'real-corpus awk row keeps 5 cells',
    splitTableRow(
      "| 2 | Assert no account has an empty password | `ansible.builtin.command: awk -F: '($2==\"\"){print $1}' /etc/shadow` + `assert` | A fail-closed control |"
    ),
    [
      '2',
      'Assert no account has an empty password',
      "`ansible.builtin.command: awk -F: '($2==\"\"){print $1}' /etc/shadow` + `assert`",
      'A fail-closed control',
