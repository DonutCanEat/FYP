#!/usr/bin/env node
/*
 * md2docx / convert.js
 * Dependency-free, scale-oriented Markdown -> OOXML (.docx) writer for the DSH
 * offline Windows box.
 *
 * WHY NODE
 *   pandoc is not installed, LibreOffice/soffice is not installed, 7z is not
 *   installed and the Python on PATH is a Windows Store stub that exits 9009.
 *   Node 24 is present and works. Node also handles UTF-8 natively, which avoids
 *   the ANSI/big5 code-page trap that affects PowerShell's Get-Content -Raw.
 *
 * ASSEMBLY STRATEGY (important for 200k+ word inputs)
 *   The body of word/document.xml is never held as one monolithic string.
 *   Paragraph XML fragments are produced block by block into a bounded chunk
 *   array, and each batch is:
 *     1. handed to the <w:t>/<w:p> scanner that measures the visible text
 *        (that measured text is what the completeness digest covers), and
 *     2. streamed into the ZIP local entry for word/document.xml through a raw
 *        deflate stream (zlib.createDeflateRaw) written to the output file
 *        descriptor, with the CRC-32 / size fields patched afterwards by
 *        seeking back into the local header.
 *   So peak memory is O(batch size + deflate window), not O(document size).
 *
 * USAGE
 *   node convert.js <input.md> [more.md ...] <output.docx> [--title "T"]
 *   node convert.js --config plan.json
 *   node convert.js --input a.md,b.md,c.md --output out.docx --title "T"
 *
 * CONFIG FILE (multi-file + multi-volume)
 *   {
 *     "title": "FYP Proposal",
 *     "inputs": ["01.md", "02.md", "03.md"],       // concatenated with page breaks
 *     "outputs": [
 *       { "path": "proposal.docx", "title": "FYP Proposal" },
 *       { "path": "vol1.docx", "title": "Volume 1",
 *         "rules": { "include": ["1-6", "12-20"], "exclude": ["7","8"] } },
 *       { "path": "vol2.docx", "title": "Volume 2",
 *         "rules": { "include": ["7-11", "A"] } }
 *     ]
 *   }
 *   Rules select top-level heading sections by their leading number:
 *   "include": ["1-6","12-20"] means sections 1..6 and 12..20 (by first heading
 *   number). "exclude" is applied after "include". "frontMatter": true keeps
 *   everything before the first numbered section (title page, TOC, unnumbered
 *   headings); it defaults to true for the volume that contains section 1 and
 *   false otherwise. "match" is an optional regex tested against heading text.
 *   "titlePage": true (config-wide or per output) synthesises a real title page
 *   and a TOC field for a corpus that carries no "# " H1 to promote, which is the
 *   case for a corpus whose top-level sections are written as "## 7. Title".
 *   The section boundary is the document's SHALLOWEST heading level, so such a
 *   corpus is split correctly without any change to the rule data.
 */

'use strict';

const fs = require('fs');
const path = require('path');
const zlib = require('zlib');
const crypto = require('crypto');

/* ================================================================== *
 * CRC32 + streaming ZIP writer
 * ================================================================== */
const CRC_TABLE = (() => {
  const t = new Int32Array(256);
  for (let n = 0; n < 256; n++) {
    let c = n;
    for (let k = 0; k < 8; k++) c = c & 1 ? 0xedb88320 ^ (c >>> 1) : c >>> 1;
    t[n] = c;
  }
  return t;
})();

function crc32Update(crc, buf) {
  let c = crc === null ? -1 : crc;
  for (let i = 0; i < buf.length; i++) c = CRC_TABLE[(c ^ buf[i]) & 0xff] ^ (c >>> 8);
  return c === null ? null : c;
}
const crc32Finish = (c) => (c ^ -1) >>> 0;

const ZIP_LIMIT = 0xffffff00; // non-zip64 ceiling

class ZipWriter {
  constructor(filePath) {
    this.fd = fs.openSync(filePath, 'w'); // Node >= 18 rejects the legacy 'wb'
    this.entries = [];
    this.offset = 0;
  }

  _u32(n) {
    const b = Buffer.alloc(4);
    b.writeUInt32LE(n >>> 0, 0);
    return b;
  }
  _u16(n) {
    const b = Buffer.alloc(2);
    b.writeUInt16LE(n & 0xffff, 0);
    return b;
  }
  _write(buf) {
    if (buf && buf.length) {
      fs.writeSync(this.fd, buf);
      this.offset += buf.length;
    }
  }
  _check(size) {
    if (this.offset > ZIP_LIMIT || size > ZIP_LIMIT) {
      throw new Error(
        'md2docx: output exceeds the plain-ZIP (non-zip64) 4 GiB limit; split the document into volumes'
      );
    }
  }

  /** Buffer-based entry (used for the small fixed parts). */
  add(name, data) {
    const nameBuf = Buffer.from(name, 'utf8');
    const raw = Buffer.isBuffer(data) ? data : Buffer.from(data, 'utf8');
    this._check(raw.length);
    const crc = crc32Finish(crc32Update(null, raw));
    let comp = zlib.deflateRawSync(raw, { level: 6 });
    let method = 8;
    if (comp.length >= raw.length) {
      comp = raw;
      method = 0;
    }
    const local = Buffer.concat([
      this._u32(0x04034b50),
      this._u16(20),
      this._u16(0x0800),
      this._u16(method),
      this._u16(0),
      this._u16(0x21),
      this._u32(crc),
      this._u32(comp.length),
      this._u32(raw.length),
      this._u16(nameBuf.length),
      this._u16(0),
      nameBuf,
    ]);
    const headerOffset = this.offset;
    this._write(local);
    this._write(comp);
    this.entries.push({
      name: nameBuf,
      method,
      crc,
      compSize: comp.length,
      uSize: raw.length,
      offset: headerOffset,
    });
  }

  /**
   * Streaming entry: returns a sink for a caller that produces the content in
   * many pieces. The local header is written with zeroed CRC/size fields and
   * patched when finish() is called, so nothing has to be buffered in memory.
   */
  beginStream(name) {
    const nameBuf = Buffer.from(name, 'utf8');
    const headerOffset = this.offset;
    const local = Buffer.concat([
      this._u32(0x04034b50),
      this._u16(20),
      this._u16(0x0800),
      this._u16(8), // deflate
      this._u16(0),
      this._u16(0x21),
      this._u32(0), // crc   - patched in finish()
      this._u32(0), // csize - patched in finish()
      this._u32(0), // usize - patched in finish()
      this._u16(nameBuf.length),
      this._u16(0),
      nameBuf,
    ]);
    this._write(local);
    const deflate = zlib.createDeflateRaw({ level: 6 });
    let crc = null;
    let uSize = 0;
    let compSize = 0;
    let finished = false;
    const outChunks = [];
    const self = this;

    deflate.on('data', (chunk) => {
      outChunks.push(chunk);
      compSize += chunk.length;
    });

    return {
      write(text) {
        if (!text) return;
        const buf = Buffer.isBuffer(text) ? text : Buffer.from(text, 'utf8');
        crc = crc32Update(crc, buf);
        uSize += buf.length;
        deflate.write(buf);
      },
      /**
       * Flush the deflate stream, then write its output and patch the local
       * header.
       *
       * Two non-obvious details, both found the hard way during development:
       *  1. The compressed output is collected first and written in one ordered
       *     pass. Node may emit queued 'data' events after end()'s callback, so
       *     writing straight from the handler can race with ZipWriter.close()
       *     and truncate the part.
       *  2. The signal that zlib has finished flushing is 'close', NOT the
       *     end() callback: in Node 24 end(cb) can fire while the deflate output
       *     is still empty, which produced a zero-byte word/document.xml.
       * Collecting costs only the deflated size (~1/10 of the XML); the
       * uncompressed XML is never held in memory.
       */
      finish() {
        if (finished) return Promise.resolve({ bytes: uSize, compressed: compSize });
        finished = true;
        return new Promise((resolve, reject) => {
          deflate.once('error', reject);
          deflate.once('close', () => {
            try {
              const crcVal = crc32Finish(crc);
              self._check(uSize);
              if (outChunks.length) self._write(Buffer.concat(outChunks));
              outChunks.length = 0;
              const patch = Buffer.alloc(12);
              patch.writeUInt32LE(crcVal, 0);
              patch.writeUInt32LE(compSize, 4);
              patch.writeUInt32LE(uSize, 8);
              fs.writeSync(self.fd, patch, 0, 12, headerOffset + 14);
              self.entries.push({
                name: nameBuf,
                method: 8,
                crc: crcVal,
                compSize,
                uSize,
                offset: headerOffset,
              });
              resolve({ bytes: uSize, compressed: compSize });
            } catch (err) {
              reject(err);
            }
          });
          deflate.end();
        });
      },
    };
  }

  close() {
    const centralOffset = this.offset;
    let centralSize = 0;
    for (const e of this.entries) {
      const rec = Buffer.concat([
        this._u32(0x02014b50),
        this._u16(20),
        this._u16(20),
        this._u16(0x0800),
        this._u16(e.method),
        this._u16(0),
        this._u16(0x21),
        this._u32(e.crc),
        this._u32(e.compSize),
        this._u32(e.uSize),
        this._u16(e.name.length),
        this._u16(0),
        this._u16(0),
        this._u16(0),
        this._u16(0),
        this._u32(0),
        this._u32(e.offset),
        e.name,
      ]);
      this._write(rec);
      centralSize += rec.length;
    }
    this._write(
      Buffer.concat([
        this._u32(0x06054b50),
        this._u16(0),
        this._u16(0),
        this._u16(this.entries.length),
        this._u16(this.entries.length),
        this._u32(centralSize),
        this._u32(centralOffset),
        this._u16(0),
      ])
    );
    fs.closeSync(this.fd);
    this.fd = null;
    return this.entries.length;
  }
}

/* ================================================================== *
 * Text hygiene
 * ================================================================== */
/* ================================================================== *
 * Package integrity: relationship ids and content-type declarations
 *
 * WHY THIS EXISTS
 *   An OPC package must not declare the same relationship Id twice in one
 *   .rels part, and must not declare the same <Override PartName> twice in
 *   [Content_Types].xml. Both are FATAL rather than cosmetic: Microsoft's
 *   own parser refuses the package outright with
 *       XmlException: '<id>' ID conflicts with the ID of an existing
 *       relationship for the specified source.
 *   The generator used to derive hyperlink ids as `rels.length + 10` while
 *   header/footer ids were computed independently as `11 + rels.length`, so a
 *   document with 2 distinct hyperlinks emitted rId11/rId12 twice. Exactly two
 *   URLs were needed to collide; the shipping deliverables happened to contain
 *   zero hyperlinks, which is luck, not correctness.
 *
 * Both problems are now impossible by construction:
 *   - EVERY relationship id comes from allocRelId() (one monotonic counter);
 *   - assertRelsUnique()/assertContentTypesUnique() refuse to write a package
 *     that somehow still contains a duplicate (e.g. after a future edit), so
 *     the failure is loud instead of producing an unopenable .docx.
 * ================================================================== */

/**
 * One monotonic id source; every relationship id in the package comes from it.
 *
 * `reservedCount` exists because word/_rels/document.xml.rels also carries five
 * INTENTIONALLY fixed part relationships (rId1 styles, rId2 numbering, rId3
 * settings, rId4 fontTable, rId5 theme). Reserving those numbers here means the
 * allocator's structural guarantee - "it never returns an id twice" - extends to
 * the fixed ids as well, instead of relying on a later clash check.
 */
function createRelIdAllocator(prefix, reservedCount) {
  let n = reservedCount && reservedCount > 0 ? reservedCount : 0;
  const allocated = new Map();
  const allocator = (key) => {
    if (key !== undefined && key !== null) {
      if (allocated.has(key)) return allocated.get(key);
    }
    n += 1;
    const id = `${prefix || 'rId'}${n}`;
    if (key !== undefined && key !== null) allocated.set(key, id);
    return id;
  };
  allocator.peek = () => n;
  allocator.width = 11; // legacy hint used by inlineToXml; ids are strings now
  return allocator;
}

const REL_HEAD_RE = /<Relationship\b[^>]*?\bId="([^"]*)"/g;
const OVERRIDE_HEAD_RE = /<Override\b[^>]*?\bPartName="([^"]*)"/g;
const DEFAULT_HEAD_RE = /<Default\b[^>]*?\bExtension="([^"]*)"/g;

function duplicateValues(xml, re) {
  const seen = new Map();
  let m;
  re.lastIndex = 0;
  while ((m = re.exec(xml)) !== null) {
    const key = m[1];
    seen.set(key, (seen.get(key) || 0) + 1);
  }
  return [...seen.entries()].filter(([, count]) => count > 1);
}

/** Throw if one .rels part declares the same Id more than once. */
function assertRelsUnique(partName, xml) {
  const dups = duplicateValues(xml, REL_HEAD_RE);
  if (dups.length) {
    throw new Error(
      `md2docx: refusing to write ${partName}: duplicate relationship Id(s) ` +
        dups.map(([id, n]) => `'${id}' x${n}`).join(', ') +
        ". Microsoft's Open XML SDK cannot open such a package " +
        "(XmlException: \"'<id>' ID conflicts with the ID of an existing relationship\")."
    );
  }
}

/** Throw if [Content_Types].xml declares the same PartName/Extension twice. */
function assertContentTypesUnique(xml) {
  const dupParts = duplicateValues(xml, OVERRIDE_HEAD_RE);
  const dupExts = duplicateValues(xml, DEFAULT_HEAD_RE);
  if (dupParts.length || dupExts.length) {
    throw new Error(
      'md2docx: refusing to write [Content_Types].xml: duplicate ' +
        [
          ...dupParts.map(([p, n]) => `<Override PartName="${p}"> x${n}`),
          ...dupExts.map(([e, n]) => `<Default Extension="${e}"> x${n}`),
        ].join(', ')
    );
  }
}

/** Every .rels part in the package must be duplicate-free. */
function assertPackageRelsUnique(parts) {
  const problems = [];
  for (const [partName, xml] of parts) {
    const dups = duplicateValues(xml, REL_HEAD_RE);
    if (dups.length) problems.push(`${partName}: ${dups.map(([id, n]) => `'${id}' x${n}`).join(', ')}`);
  }
  if (problems.length) {
    throw new Error(
      'md2docx: refusing to close the package: duplicate relationship Id(s) in ' + problems.join('; ')
    );
  }
}

function stripIllegalXmlChars(s) {
  let out = '';
  let last = 0;
  for (let i = 0; i < s.length; i++) {
    const c = s.charCodeAt(i);
    let bad = false;
    if (c === 0x9 || c === 0xa) {
      /* keep */
    } else if (c === 0xd || c < 0x20) {
      bad = true;
    } else if (c === 0xfffe || c === 0xffff) {
      bad = true;
    } else if (c >= 0xd800 && c <= 0xdfff) {
      const n = s.charCodeAt(i + 1);
      if (c <= 0xdbff && n >= 0xdc00 && n <= 0xdfff) {
        i++;
        continue;
      }
      bad = true;
    }
    if (bad) {
      if (i > last) out += s.slice(last, i);
      last = i + 1;
    }
  }
  if (last === 0) return s;
  out += s.slice(last);
  return out;
}

function esc(s) {
  let out = '';
  for (let i = 0; i < s.length; i++) {
    const ch = s[i];
    if (ch === '&') out += '&amp;';
    else if (ch === '<') out += '&lt;';
    else if (ch === '>') out += '&gt;';
    else if (ch === '"') out += '&quot;';
    else out += ch;
  }
  return out;
}

function unesc(s) {
  return String(s)
    .replace(/&lt;/g, '<')
    .replace(/&gt;/g, '>')
    .replace(/&quot;/g, '"')
    .replace(/&apos;/g, "'")
    .replace(/&amp;/g, '&');
}

function t(text) {
  if (text === undefined || text === null || text === '') return '';
  return /^\s|\s$/.test(text)
    ? `<w:t xml:space="preserve">${esc(text)}</w:t>`
    : `<w:t>${esc(text)}</w:t>`;
}

function normaliseNewlines(s) {
  return s.replace(/\r\n/g, '\n').replace(/\r/g, '\n');
}

/* ================================================================== *
 * Canonical visible text (the completeness proof)
 * ================================================================== */
const CANON_RULE = '\u2015';
const CANON_FIGURE_PREFIX = '[FIGURE] ';
const CANON_TOC_PLACEHOLDER =
  'Right-click here and choose "Update Field" (or press F9) to build the table of contents.';

/*
 * The .docx holds the *rendered* text of inline runs ("**bold**" -> "bold"), so
 * the digest comparison normalises both sides with this stripper: here on the
 * markdown lines / measured <w:t> text, and in validate.ps1 with an equivalent
 * PowerShell implementation (Remove-RenderedInlineSyntax).
 *
 * IMPORTANT - this normalisation is lossy and cannot be inverted: the literal
 * asterisks that survive inside a code span are indistinguishable from emphasis
 * markers once the backticks are gone. For that reason the digest built from this
 * function is a self-consistency / truncation check only, NOT a completeness
 * proof. Completeness is proved by the validator's per-line coverage check, which
 * compares raw (un-normalised) source lines against the document text.
 */
function stripInlineSyntax(s) {
  const codeSpans = [];
  let out = String(s === undefined || s === null ? '' : s)
    .replace(/`([^`]+)`/g, (m, inner) => {
      codeSpans.push(inner);
      return '\u0000C' + (codeSpans.length - 1) + '\u0000';
    });
  out = out
    .replace(/!\[([^\]]*)\]\(([^)]*)\)/g, '$1')
    .replace(/\[((?:[^\[\]\\]|\\.)*)\]\(([^)]*)\)/g, '$1')
    .replace(/<((?:https?|mailto):[^<>\s]+)>/g, '$1')
    .replace(/\*\*\*([^*]+)\*\*\*/g, '$1')
    .replace(/\*\*([^*]+)\*\*/g, '$1')
    // An emphasis marker must not be adjacent to another '*', so literal
    // asterisks that survive inside a code span ("code_span_with_*stars*") are
    // left alone. The writer emits that content verbatim, and the docx-side
    // stripper in validate.ps1 uses the same anchored rule.
    .replace(/(?<!\*)\*([^*]+)\*(?!\*)/g, '$1')
    // '_' emphasis is restricted to word boundaries: a global rule would eat the
    // underscores inside an identifier such as code_span_with_stars.
    .replace(/(^|[\s(])_([^_\s](?:[^_]*[^_\s])?)_(?=[\s.,;:)!?]|$)/g, '$1$2')
    .replace(/~~([^~]+)~~/g, '$1')
    .replace(/\\([\\`*_{}\[\]()#+\-.!>|~])/g, '$1');
  // restore code spans (a mask that was never created cannot appear)
  out = out.replace(/\u0000C(\d+)\u0000/g, (m, i) => codeSpans[Number(i)]);
  return out;
}

/** One canonical line per visible text run: strip markers, then join. */
function canonLinesOf(s) {
  return stripInlineSyntax(s);
}

function canon(parts) {
  // Join with a space, then collapse every whitespace run to a single space.
  // Collapsing is what makes this idempotent and therefore comparable: a part
  // that already ends in a space and a part that does not both normalise to the
  // same single separator, so the markdown side (per-line parts) and the docx
  // side (per-<w:t> parts) agree exactly.
  const text = parts
    .map((s) => (s === undefined || s === null ? '' : String(s).trim()))
    .filter((s) => s !== '')
    .join(' ')
    .replace(/\s+/g, ' ')
    .trim();
  return {
    text,
    hash: crypto.createHash('sha256').update(text, 'utf8').digest('hex'),
    chars: text.length,
    charsNoSpaces: text.replace(/\s/g, '').length,
    words: text === '' ? 0 : text.split(' ').length,
  };
}

/** Canonical visible text of a Markdown document, mirroring the writer exactly. */
function markdownToCanonicalParts(md) {
  return partsOfBlocks(parseMarkdown(md));
}

/**
 * Raw visible paragraphs of an assembled document.xml.
 *
 * This is the same extraction the validator performs (only <w:t> content counts;
 * <w:instrText> and <w:delText> are excluded; runs are concatenated, then each
 * paragraph is trimmed and whitespace-collapsed). Comparing the digest of these
 * paragraphs against the Markdown paragraphs is what turns the writer's
 * self-check into a truncation check: if a paragraph were dropped or cut short,
 * the digests would diverge.
 */
function extractDocumentParagraphs(documentXml) {
  const out = [];
  const paraRe = /<w:p(?:\s[^>]*)?>([\s\S]*?)<\/w:p>/g;
  let pm;
  while ((pm = paraRe.exec(documentXml)) !== null) {
    const inner = pm[1];
    let text = '';
    const skip = /<w:instrText(?:\s[^>]*)?>[\s\S]*?<\/w:instrText>|<w:delText(?:\s[^>]*)?>[\s\S]*?<\/w:delText>/g;
    const kept = inner.replace(skip, '');
    const tRe = /<w:t(?:\s[^>]*)?>([\s\S]*?)<\/w:t>/g;
    let tm;
    while ((tm = tRe.exec(kept)) !== null) text += unesc(tm[1]);
    const v = text.trim();
    if (v) out.push(v);
  }
  return out;
}

/**
 * Canonical text parts of already-parsed blocks.
 *
 * These are RAW visible parts: no inline-syntax stripping is applied, because the
 * document side of the comparison is the raw concatenated <w:t> text. Both sides
 * are therefore produced by the same rule (paragraph text, trimmed, whitespace
 * collapsed), which makes the digest a meaningful self-consistency check: if the
 * writer ever drops, truncates or mangles a paragraph, the two digests diverge.
 *
 * It is deliberately NOT a completeness proof against the Markdown: normalising
 * markdown emphasis is lossy in a way that cannot be inverted (see the note above
 * stripInlineSyntax). Completeness is proved by validate.ps1's coverage check.
 */
function partsOfBlocks(blocks) {
  const out = [];
  const push = (s) => {
    const v = String(s === undefined || s === null ? '' : s).trim();
    if (!v) return;
    // Normalise the same way the writer renders: the document contains the
    // rendered text, so markdown inline markers are removed from this side to
    // make the two digests comparable.
    const n = stripInlineSyntax(v).replace(/[`*~]/g, '').replace(/\s+/g, ' ').trim();
    out.push(n);
  };
  for (const b of blocks) {
    switch (b.type) {
      case 'heading':
        push(b.text);
        break;
      case 'para':
        for (const l of b.lines) push(l);
        break;
      case 'list':
        for (const it of b.items) {
          const text = it.parts.join(' ').trim();
          const task = /^\[( |x|X)\]\s+(.*)$/.exec(text);
          if (task) {
            const box = task[1].toLowerCase() === 'x' ? '\u2611' : '\u2610';
            out.push(box + ' ' + stripInlineSyntax(task[2]).replace(/[`*~]/g, '').replace(/\s+/g, ' ').trim());
          } else {
            push(text);
          }
        }
        break;
      case 'table':
        push(b.header.join(' '));
        for (const r of b.rows) push(r.join(' '));
        break;
      case 'code':
        if (b.lang) push(b.lang);
        for (const l of b.lines) push(l.replace(/\t/g, '    '));
        break;
      case 'quote':
        for (const l of b.text.split('\n')) push(l);
        break;
      case 'hr':
        push(CANON_RULE);
        break;
      case 'figure':
        push(CANON_FIGURE_PREFIX + b.text);
        break;
      case 'toc':
        push('Table of Contents');
        push(CANON_TOC_PLACEHOLDER);
        break;
      case 'subtitle':
        // Synthetic title-page subtitle (corpus with no H1); the H1 path in
        // buildDocument already unshifts opt.subtitle for the normal case.
        push(stripInlineSyntax(b.text).trim());
        break;
      case 'pagebreak':
        break;
      default:
        break;
    }
  }
  return out;
}

/* ================================================================== *
 * Ordered serialiser for WordprocessingML property elements
 *
 * WHY THIS EXISTS
 *   WordprocessingML enforces a strict child-element ORDER for every
 *   complex type: a child emitted out of order is a schema violation, and
 *   Microsoft's Open XML SDK reports it as
 *   "The element has unexpected child element 'w:...'".
 *   Before this serialiser existed the emitter wrote some fragments ad hoc
 *   (e.g. `<w:noProof/><w:rFonts .../>`), which produced ~10,000 violations
 *   per document - roughly one per code-block line.
 *
 * The orders below are NOT recalled from documentation: each was read out of
 * Microsoft's own Open XML SDK 2.9.1 assembly (the *Properties / *Default
 * properties are declared in schema order) and then confirmed empirically by
 * validating a generated package with
 * `DocumentFormat.OpenXml.Validation.OpenXmlValidator`. `--selftest` asserts
 * that these tables are exactly the SDK's sequences.
 *
 * Use normalizeElement() so ordering is structural: a future edit cannot
 * reintroduce the bug by emitting a child in the wrong place, because the
 * children are re-ordered just before the fragment is written.
 * ================================================================== */

/** `<w:tag .../>` or `<w:tag ...>`; index 1 is the element name. */
const ELEMENT_HEAD_RE = /^<(?:[A-Za-z_][\w.-]*:)?([A-Za-z_][\w.-]*)(?=[\s/>])/;

/** Canonical child order for each element the generator emits. */
const WP_ORDER = {
