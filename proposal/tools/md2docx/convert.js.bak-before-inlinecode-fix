/** Tag name of a fragment, or null when it is not a single element. */
function elementNameOf(fragment) {
  const m = ELEMENT_HEAD_RE.exec(fragment);
  return m ? m[1] : null;
}

/**
 * Split one element's inner XML into child fragments and bucket them by name.
 * Depth-tracked so that a child's own nested elements are never split apart.
 * BOTH void children (`<w:jc/>`) and container children
 * (`<w:tblBorders>…</w:tblBorders>`) are bucketed: tblPr's canonical order puts
 * tblLayout after the tblBorders *container*, so containers must be
 * re-orderable units too.
 */
function splitChildElements(inner) {
  const children = [];
  const buckets = new Map();
  const total = inner.length;
  let i = 0;
  while (i < total) {
    if (inner[i] !== '<') {
      i++;
      continue;
    }
    const start = i;
    let depth = 0;
    let closed = false;
    while (i < total) {
      if (inner[i] === '<') {
        if (inner.startsWith('<!--', i)) {
          const end = inner.indexOf('-->', i);
          i = end === -1 ? total : end + 3;
          continue;
        }
        const tagEnd = inner.indexOf('>', i);
        if (tagEnd === -1) { i = total; break; }
        // A tag is self-closing iff the character before '>' is '/'. Lookahead
        // by a fixed window is wrong here: "<w:sz w:val=.." has no '/' in the
        // first few characters and would be misread as a container.
        const selfClosing = inner[tagEnd - 1] === '/';
        const isClose = inner[i + 1] === '/';
        i = tagEnd + 1;
        if (selfClosing) {
          if (depth === 0) { closed = true; break; }
          continue;
        }
        if (isClose) {
          depth--;
          if (depth === 0) { closed = true; break; }
          continue;
        }
        depth++;
        continue;
      }
      i++;
    }
    if (!closed) i = total;
    const fragment = inner.slice(start, i);
    const name = elementNameOf(fragment);
    children.push(fragment);
    if (name) {
      if (!buckets.has(name)) buckets.set(name, []);
      buckets.get(name).push(fragment);
    }
  }
  return { children, buckets };
}

/**
 * Re-order the children of one element fragment into `order`.
 *
 * Children named in `order` are emitted in that canonical sequence; anything
 * not named (or named but not present in `order`) keeps its original relative
 * position at the end. Returns the fragment unchanged when it is not an
 * element or when nothing had to move, so untouched output is byte-identical.
 */
function normalizeElement(name, fragment, order) {
  if (!fragment || !order) return fragment;
  const trimmed = fragment.trim();
  if (!trimmed || trimmed[0] !== '<' || trimmed[1] === '/') return fragment;
  if (elementNameOf(trimmed) !== name) return fragment;

  const openEnd = trimmed.indexOf('>');
  if (openEnd === -1) return fragment;
  const openTag = trimmed.slice(0, openEnd + 1);
  if (/\/>$/.test(openTag)) return fragment; // void element: no children
  const closeTag = `</${openTag.slice(1, -1).split(/[\s>]/)[0]}>`;
  if (!trimmed.endsWith(closeTag)) return fragment; // unexpected shape: leave alone
  const inner = trimmed.slice(openEnd + 1, trimmed.length - closeTag.length);

  const { children, buckets } = splitChildElements(inner);
  const placed = new Set();
  const out = [];
  for (const key of order) {
    if (!buckets.has(key)) continue;
    placed.add(key);
    out.push(key);
  }
  const buckets2 = new Map();
  for (const [key, list] of buckets) if (placed.has(key)) buckets2.set(key, list);

  let result = '';
  let wroteOrdered = false;
  const emitRemaining = () => {
    for (const child of children) {
      const nm = elementNameOf(child);
      if (nm && buckets2.has(nm)) continue; // emitted in canonical position
      result += child;
    }
  };
  for (const key of out) {
    // Any unplaced child that came *before* this key in the original order is
    // emitted first, so unknown content keeps its relative position.
    if (!wroteOrdered) {
      const firstIdx = children.findIndex((c) => elementNameOf(c) === key);
      for (let k = 0; k < firstIdx; k++) {
        const nm = elementNameOf(children[k]);
        if (nm && buckets2.has(nm)) continue;
        result += children[k];
      }
      wroteOrdered = true;
    }
    result += buckets2.get(key).join('');
  }
  emitRemaining();
  const rebuilt = openTag + result + closeTag;
  return rebuilt === trimmed ? fragment : rebuilt;
}

/**
 * One-pass serialiser: normalise every property element that has a declared
 * canonical order, innermost first (pPr/rPr/tblPr all contain no property
 * element with an order, but nesting-safety here costs nothing).
 */
const NORMALIZE_KEYS = ['tblPr', 'pPr', 'rPr'];
function normalizeOrderedElements(xml) {
  if (!xml || xml.indexOf('<w:') === -1) return xml;
  let out = xml;
  for (const key of NORMALIZE_KEYS) {
    const order = WP_ORDER[key];
    const open = `<w:${key}>`;
    const openSelf = `<w:${key}/>`;
    const closeTag = `</w:${key}>`;
    let from = 0;
    for (;;) {
      const idx = out.indexOf(open, from);
      if (idx === -1) break;
      if (out.startsWith(openSelf, idx)) {
        from = idx + openSelf.length;
        continue;
      }
      const end = out.indexOf(closeTag, idx + open.length);
      if (end === -1) break;
      const after = end + closeTag.length;
      const fragment = out.slice(idx, after);
      const fixed = normalizeElement(key, fragment, order);
      if (fixed !== fragment) out = out.slice(0, idx) + fixed + out.slice(after);
      from = idx + fixed.length;
    }
  }
  return out;
}

/* ================================================================== *
 * Inline runs
 * ================================================================== */
const RUN_PROPS = {
  bold: '<w:rPr><w:b/></w:rPr>',
  italic: '<w:rPr><w:i/></w:rPr>',
  boldItalic: '<w:rPr><w:b/><w:i/></w:rPr>',
  strike: '<w:rPr><w:strike/></w:rPr>',
  code: '<w:rPr><w:rStyle w:val="MonoChar"/></w:rPr>',
};

function run(text, propXml) {
  if (text === '') return '';
  return `<w:r>${propXml || ''}${t(text)}</w:r>`;
}

function inlineToXml(src, relAlloc) {
  let out = '';
  let buf = '';
  const flush = (props) => {
    if (buf) {
      out += run(buf, props);
      buf = '';
    }
  };
  let i = 0;
  const n = src.length;
  // relAlloc(url) returns a COMPLETE id string ("rId8"), never a bare number:
  // the allocator is the single source of truth for relationship ids.
  while (i < n) {
    const c = src[i];

    if (c === '\\' && i + 1 < n && '\\`*_{}[]()#+-.!>|~'.indexOf(src[i + 1]) >= 0) {
      buf += src[i + 1];
      i += 2;
      continue;
    }

    if (c === '`') {
      let ticks = 0;
      while (src[i + ticks] === '`') ticks++;
      const close = src.indexOf('`'.repeat(ticks), i + ticks);
      if (close > -1) {
        flush();
        let codeSpan = src.slice(i + ticks, close).replace(/\n/g, ' ');
        if (/^ .* $/.test(codeSpan) && codeSpan.trim() !== '') codeSpan = codeSpan.slice(1, -1);
        out += run(codeSpan, RUN_PROPS.code);
        i = close + ticks;
        continue;
      }
      buf += src.slice(i, i + ticks);
      i += ticks;
      continue;
    }

    if (c === '<') {
      const m = /^<((?:https?|mailto):[^<>\s]+)>/.exec(src.slice(i));
      if (m) {
        flush();
        const id = relAlloc ? relAlloc(m[1]) : null;
        if (id !== null && id !== undefined) {
          out +=
            `<w:hyperlink r:id="${id}"><w:r><w:rPr><w:rStyle w:val="Hyperlink"/></w:rPr>${t(
              m[1]
            )}</w:r></w:hyperlink>`;
        } else {
          out += run(m[1], '<w:rPr><w:rStyle w:val="Hyperlink"/></w:rPr>');
        }
        i += m[0].length;
        continue;
      }
      buf += c;
      i++;
      continue;
    }

    if (c === '[') {
      const m = /^\[((?:[^\[\]\\]|\\.)*)\]\(\s*<?([^)\s>]+)>?(?:\s+["'][^"']*["'])?\s*\)/.exec(
        src.slice(i)
      );
      if (m) {
        flush();
        const label = m[1].replace(/\\([\\`*_{}\[\]()#+\-.!>|~])/g, '$1');
        const inner = inlineToXml(label, null);
        const id = relAlloc ? relAlloc(m[2]) : null;
        if (id !== null && id !== undefined) {
          out += `<w:hyperlink r:id="${id}">${inner.replace(
            /<w:r>(?!<w:rPr>)/g,
            '<w:r><w:rPr><w:rStyle w:val="Hyperlink"/></w:rPr>'
          )}</w:hyperlink>`;
        } else {
          out += inner;
        }
        i += m[0].length;
        continue;
      }
      buf += c;
      i++;
      continue;
    }

    if (c === '*' || c === '_') {
      const ch = c;
      let len = 0;
      while (src[i + len] === ch) len++;
      if (len <= 3) {
        const marker = ch.repeat(len);
        const close = findEmphasisClose(src, i + len, marker);
        if (close > -1) {
          const inner = src.slice(i + len, close);
          if (inner.length > 0 && !/^\s|\s$/.test(inner)) {
            flush();
            const props =
              len === 1 ? RUN_PROPS.italic : len === 2 ? RUN_PROPS.bold : RUN_PROPS.boldItalic;
            const nested = inlineToXml(inner, null);
            out += nested.replace(/<w:r>(?!<w:rPr>)/g, `<w:r>${props}`);
            i = close + len;
            continue;
          }
        }
      }
      buf += ch.repeat(len);
      i += len;
      continue;
    }

    if (c === '~' && src[i + 1] === '~') {
      const close = src.indexOf('~~', i + 2);
      if (close > -1 && close > i + 2) {
        flush();
        out += run(src.slice(i + 2, close), RUN_PROPS.strike);
        i = close + 2;
        continue;
      }
      buf += '~~';
      i += 2;
      continue;
    }

    buf += c;
    i++;
  }
  flush();
  return out;
}

function findEmphasisClose(src, from, marker) {
  let idx = src.indexOf(marker, from);
  while (idx > -1) {
    const after = src[idx + marker.length];
    if (after === undefined || !/[0-9]/.test(after)) return idx;
    idx = src.indexOf(marker, idx + 1);
  }
  return -1;
}

/* ================================================================== *
 * Markdown block parser
 * ================================================================== */
const LIST_INDENT_UNIT = 2;

function isTableSeparator(line) {
  return (
    /^\s*\|?\s*:?-{1,}:?\s*(\|\s*:?-{1,}:?\s*)*\|?\s*$/.test(line) && line.indexOf('-') > -1
  );
}

/**
 * Split a GitHub-flavoured Markdown table row into cells.
 *
 * Two things must survive that a naive split on every '|' destroys:
 *
 *   1. '\|' - an escaped pipe becomes a LITERAL pipe inside one cell and never a
 *      separator. This is what the corpus uses for cells such as
 *      `DL-{Share}-{RW\|RO}` and file paths containing '|'.
 *   2. A '|' inside an inline code span - `ansible.builtin.command: awk -F: ...`,
 *      or `{A|B|C|D}` - is cell CONTENT, not a separator. Inside a code span the
 *      rendered text is literal, so treating it as a separator would split one
 *      cell into several and shift every later column.
 *
 * PRECEDENCE, as implemented (and as GitHub renders it): escaping always wins.
 * '\|' is consumed as a literal pipe before the code-span toggle is consulted, so
 * a pipe written as '\|' inside a code span is also literal. Outside code spans
 * an unescaped '|' is always a separator.
 *
 * The toggle below is deliberately simple: it flips on every backtick. That is
 * exactly how CommonMark delimits code spans of length 1, and it re-synchronises
 * correctly even when a cell contains several code spans (the toggles cancel out).
 */
function splitTableRow(line) {
  let s = line.trim();
  if (s.startsWith('|')) s = s.slice(1);
  if (s.endsWith('|') && !s.endsWith('\\|')) s = s.slice(0, -1);
  const cells = [];
  let cur = '';
  let inCode = false;
  for (let i = 0; i < s.length; i++) {
    const ch = s[i];
    if (ch === '\\' && s[i + 1] === '|') {
      cur += '|';
      i++;
      continue;
    }
    if (ch === '`') {
      inCode = !inCode;
      cur += ch;
      continue;
    }
    if (ch === '|' && !inCode) {
      cells.push(cur.trim());
      cur = '';
      continue;
    }
    cur += ch;
  }
  cells.push(cur.trim());
  return cells;
}

const HR_RE = /^\s{0,3}(?:(?:-\s*){3,}|(?:\*\s*){3,}|(?:_\s*){3,})$/;

/* ------------------------------------------------------------------ *
 * Fenced code blocks: STRICT fence recognition
 *
 * A naive scanner (toggle on every line that begins with ```) shifts the fence
 * parity of the rest of the file when a code block INTERNALLY contains a
 * backtick sequence at the start of a line. 07-ai.md exercises exactly that
 * shape: a doc-draft Skill example whose JSON payload embeds a ``` sequence.
 *
 * The rule used here is the CommonMark one, which makes a mis-detection
 * impossible rather than merely unlikely:
 *
 *   - a fence line is indented by at most 3 spaces; 4+ spaces makes it code
 *     content, even inside a fenced block;
 *   - an OPENING fence may carry an info string (```json);
 *   - a CLOSING fence must be BARE - nothing but the fence run and optional
 *     whitespace - and must use the same character and be at least as long as
 *     the opener.
 *
 * Consequence: "```json" can never close a block, an indented "    ```" can
 * never open or close one, and "````" never closes a "```" block.
 * ------------------------------------------------------------------ */
const FENCE_OPEN_RE = /^ {0,3}(`{3,}|~{3,})[ \t]*([A-Za-z0-9_+.#-]*)[ \t]*$/;
const FENCE_CLOSE_RE = /^ {0,3}(`{3,}|~{3,})[ \t]*$/;

/** Opening fence => { marker, len, lang } or null. */
function matchOpeningFence(line) {
  const m = FENCE_OPEN_RE.exec(line);
  if (!m) return null;
  return { marker: m[1][0], len: m[1].length, lang: m[2] || '' };
}

/** True when `line` legally closes the block opened by `openFence`. */
function isClosingFenceFor(line, openFence) {
  const m = FENCE_CLOSE_RE.exec(line);
  if (!m) return false;
  return m[1][0] === openFence.marker && m[1].length >= openFence.len;
}

function parseMarkdown(md) {
  const lines = md.split('\n');
  const blocks = [];
  let i = 0;
  const N = lines.length;
  const isBlank = (s) => /^\s*$/.test(s);
  // Ragged table rows are recorded rather than thrown: a row whose cell count
  // differs from the header must not abort a 300,000-word conversion, but the
  // caller has to be told, because it usually means the Markdown is malformed.
  const warnings = [];
  const directives = [];
  const noteRagged = (lineNo, got, want) =>
    warnings.push({ line: lineNo + 1, cells: got, headerCells: want });

  while (i < N) {
    const line = lines[i];
    if (isBlank(line)) {
      i++;
      continue;
    }

    const fence = matchOpeningFence(line);
    if (fence) {
      const body = [];
      i++;
      while (i < N) {
        if (isClosingFenceFor(lines[i], fence)) {
          i++;
          break;
        }
        body.push(lines[i]);
        i++;
      }
      blocks.push({ type: 'code', lang: fence.lang, lines: body });
      continue;
    }

    // md2docx directives: HTML comments of the form <!-- md2docx:... --> are
    // tooling instructions, consumed here and never written to the document.
    const directive = /^\s*<!--\s*md2docx:([A-Za-z-]+)\s*-->\s*$/.exec(line);
    if (directive) {
      directives.push({ name: directive[1].toLowerCase(), line: i + 1 });
      i++;
      continue;
    }

    const h = /^\s{0,3}(#{1,6})\s+(.*?)\s*#*\s*$/.exec(line);
    if (h) {
      blocks.push({ type: 'heading', level: h[1].length, text: h[2] });
      i++;
      continue;
    }

    if (HR_RE.test(line)) {
      blocks.push({ type: 'hr' });
      i++;
      continue;
    }

    if (/^\s*\[TOC\]\s*$/i.test(line)) {
      blocks.push({ type: 'toc' });
      i++;
      continue;
    }

    const fig = /^\s*\[FIGURE:\s*(.*?)\s*\]\s*$/i.exec(line);
    if (fig) {
      blocks.push({ type: 'figure', text: fig[1] });
      i++;
      continue;
    }

    if (/^\s{0,3}>/.test(line)) {
      const inner = [];
      while (i < N) {
        const m = /^\s{0,3}>\s?(.*)$/.exec(lines[i]);
        if (!m) {
          if (isBlank(lines[i]) && i + 1 < N && /^\s{0,3}>/.test(lines[i + 1])) {
            inner.push('');
            i++;
            continue;
          }
          break;
        }
        inner.push(m[1]);
        i++;
      }
      blocks.push({ type: 'quote', text: inner.join('\n') });
      continue;
    }

    if (line.indexOf('|') > -1 && i + 1 < N && isTableSeparator(lines[i + 1])) {
      // A <!-- md2docx:expect-ragged --> directive immediately above the header
      // declares that ragged rows in THIS table are intentional, so they are
      // normalised quietly instead of being reported.
      const tableExpectsRagged = i > 0 && /md2docx:expect-ragged/i.test(lines[i - 1]);
      const header = splitTableRow(line);
      const align = splitTableRow(lines[i + 1]).map((c) => {
        const l = c.startsWith(':');
        const r = c.endsWith(':');
        return l && r ? 'center' : r ? 'right' : l ? 'left' : 'left';
      });
      i += 2;
      const rows = [];
      while (i < N && !isBlank(lines[i]) && lines[i].indexOf('|') > -1) {
        const cells = splitTableRow(lines[i]);
        if (cells.length !== header.length) {
          if (!tableExpectsRagged) noteRagged(i, cells.length, header.length);
        }
        // Normalise to the header's column count so the Word table stays
        // rectangular: short rows are padded with empty cells, long rows are
        // truncated.
        if (cells.length < header.length) {
          while (cells.length < header.length) cells.push('');
        } else if (cells.length > header.length) {
          cells.length = header.length;
        }
        rows.push(cells);
        i++;
      }
      blocks.push({ type: 'table', header, align, rows, headerCells: header.length });
      continue;
    }

    if (/^\s{0,6}([-*+]|\d{1,9}[.)])\s+/.test(line)) {
      const items = [];
      let cur = null;
      while (i < N) {
        const li = lines[i];
        if (isBlank(li)) {
          if (i + 1 < N && /^\s{0,6}([-*+]|\d{1,9}[.)])\s+/.test(lines[i + 1])) {
            i++;
            continue;
          }
          break;
        }
        const m = /^(\s{0,6})([-*+]|\d{1,9}[.)])(\s+)(.*)$/.exec(li);
        if (m) {
          if (cur) items.push(cur);
          cur = {
            level: Math.min(2, Math.floor(m[1].replace(/\t/g, '  ').length / LIST_INDENT_UNIT)),
            ordered: /^\d/.test(m[2]),
            parts: [m[4]],
          };
          i++;
          continue;
        }
        if (cur && /^\s+\S/.test(li)) {
          cur.parts.push(li.trim());
          i++;
          continue;
        }
        break;
      }
      if (cur) items.push(cur);
      blocks.push({ type: 'list', items });
      continue;
    }

    const para = [line.trim()];
    i++;
    while (i < N) {
      const l = lines[i];
      if (isBlank(l)) break;
      if (/^\s{0,3}(#{1,6}\s|>|```|~~~)/.test(l)) break;
      if (/^\s*\[TOC\]\s*$/i.test(l) || /^\s*\[FIGURE:/i.test(l)) break;
      if (HR_RE.test(l)) break;
      if (/^\s{0,6}([-*+]|\d{1,9}[.)])\s+/.test(l)) break;
      if (l.indexOf('|') > -1 && i + 1 < N && isTableSeparator(lines[i + 1])) break;
      para.push(l.trim());
      i++;
    }
    blocks.push({ type: 'para', lines: para });
  }
  // Attach the ragged-row warnings to the result without changing the shape of
  // the array (callers iterate the blocks).
  Object.defineProperty(blocks, 'tableWarnings', { value: warnings, enumerable: false });
  Object.defineProperty(blocks, 'directives', { value: directives, enumerable: false });
  return blocks;
}

/* ================================================================== *
 * Section splitting (data-driven volumes)
 * ================================================================== */
/**
 * Leading section number of a heading.
 *
 * Deliberately tolerant about the separator ('.', ')', ':', ',' or end of string)
 * and about an optional word prefix, because real proposals write headings in
 * many ways:
 *     "# 3 Microsoft Infrastructure"
 *     "## 3.2 Active Directory"
 *     "# Volume Section 3: Linux Platform"
 *     "## Chapter 7 - Automation"
 * Split rules such as {"include":["1-6","12-20"]} are matched against the number
 * returned here, so being strict here would silently mis-select whole chapters.
 */
function leadingSectionKey(text) {
  const t = String(text === undefined || text === null ? '' : text).trim();
  if (!t) return null;
  const m = /(?:^|[\s([-])([A-Za-z]{0,12}[\s-]{0,2})?(\d{1,3})(?:[.)\]:,-]|\s|$)/.exec(t);
  if (m) return String(parseInt(m[2], 10));
  const a = /^(?:appendix\s+)?([A-Z])(?:[.)\]:,-]|\s|$)/i.exec(t);
  if (a) return a[1].toUpperCase();
  return null;
}

/** Expand ["1-6","12-20","A"] into a Set of section keys ("1".."20","A"). */
function expandRangeList(list) {
  const set = new Set();
  for (const raw of list || []) {
    const item = String(raw).trim();
    if (!item) continue;
    const range = /^(\d{1,3})\s*-\s*(\d{1,3})$/.exec(item);
    if (range) {
      const a = parseInt(range[1], 10);
      const b = parseInt(range[2], 10);
      for (let k = Math.min(a, b); k <= Math.max(a, b); k++) set.add(String(k));
    } else {
      set.add(/^\d+$/.test(item) ? String(parseInt(item, 10)) : item.toUpperCase());
    }
  }
  return set;
}

function sectionKeyOfGroup(group, topLevel) {
  for (const b of group.blocks) {
    if (b.type === 'heading' && (!topLevel || b.level === topLevel)) {
      const k = leadingSectionKey(b.text);
      if (k) return k.toUpperCase();
    }
  }
  return null;
}

/**
 * Shallowest heading level present (the document's own top level).
 *
 * A corpus is not required to start at "# ". A document whose top-level sections
 * are written as "## 7. Cisco Networking" has NO H1 at all, and hard-coding
 * "level === 1" as the group boundary would then swallow the entire document into
 * a single front-matter group: section keys would never be derived and every
 * "include" rule would select nothing. Deriving the boundary from the content
 * keeps the rule engine correct for both styles, and for the usual H1-based
 * document minLevel is 1 and the behaviour is unchanged.
 */
function groupHeadingLevel(blocks) {
  let min = null;
  for (const b of blocks) {
    if (b.type !== 'heading') continue;
    const lvl = Math.min(6, Math.max(1, b.level));
    if (min === null || lvl < min) min = lvl;
  }
  return min === null ? 1 : min;
}

/**
 * Group a block list into top-level sections (each starting at the document's
 * shallowest heading level - H1 normally, H2 when the document uses no H1) and
 * apply a rule set: {include:[...], exclude:[...], match:"regex", frontMatter:bool}.
 */
function applySectionRules(blocks, rules) {
  if (!rules) return blocks;
  const include = rules.include ? expandRangeList(rules.include) : null;
  const exclude = rules.exclude ? expandRangeList(rules.exclude) : new Set();
  const match = rules.match ? new RegExp(rules.match, 'i') : null;
  const topLevel = groupHeadingLevel(blocks);

  const groups = [];
  let current = { key: null, blocks: [], front: true };
  for (const b of blocks) {
    if (b.type === 'heading' && b.level === topLevel) {
      if (current.blocks.length) groups.push(current);
      const key = leadingSectionKey(b.text);
      current = { key: key ? key.toUpperCase() : null, blocks: [b], front: !key, heading: b.text };
    } else {
      current.blocks.push(b);
    }
  }
  if (current.blocks.length) groups.push(current);

  const hasSection1 = groups.some((g) => g.key === '1');
  const keepFrontMatter =
    rules.frontMatter === undefined ? hasSection1 : rules.frontMatter === true;

  const out = [];
  for (const g of groups) {
    if (g.front) {
      if (keepFrontMatter) for (const b of g.blocks) out.push(b);
      continue;
    }
    let keep;
    if (match) keep = match.test(g.heading || '');
    else if (include) keep = include.has(g.key);
    else keep = true;
    if (keep && exclude.has(g.key)) keep = false;
    if (keep) for (const b of g.blocks) out.push(b);
  }
  return out;
}

